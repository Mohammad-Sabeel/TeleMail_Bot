# copy to .env and fill in. .env is gitignored and must stay that way.
OPENROUTER_API_KEY=
# Any open-weight model supporting JSON output. Choose it with:
#   python -m scripts.probe_model --model <id>
MODEL_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional: URL reputation in the report. Empty means no lookups are made.
VIRUSTOTAL_API_KEY=

# Days before an email loses its preview text (metadata stays). Labelled mail is exempt.
RETENTION_DAYS=3
